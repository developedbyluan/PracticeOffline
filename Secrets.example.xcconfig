// Template for Secrets.xcconfig (which is gitignored).
// Copy this file to Secrets.xcconfig and fill in the real values.

// Clerk Dashboard → API keys → Publishable key (starts with pk_)
CLERK_PUBLISHABLE_KEY = pk_test_REPLACE_ME

// flucom-api Basic auth for uploading sessions: the same values as
// EXPO_PUBLIC_API_USER and EXPO_PUBLIC_API_PASS in the Android project's .env
API_USER = REPLACE_ME
API_PASS = REPLACE_ME

// commonvocab server Basic auth for pinned messages: the same values as
// EXPO_PUBLIC_COMMONVOCAB_API_USER and EXPO_PUBLIC_COMMONVOCAB_API_PASS in the Android .env
COMMONVOCAB_API_USER = REPLACE_ME
COMMONVOCAB_API_PASS = REPLACE_ME
